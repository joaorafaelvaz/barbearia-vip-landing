# Banco (Postgres). Em dev local: ver README para subir o Postgres.
DATABASE_URL="postgresql://postgres@localhost:5432/barbearia_vip_dev"
# Usado pelo vitest (tests/setup.ts recria o schema a cada execução)
DATABASE_URL_TEST="postgresql://postgres@localhost:5432/barbearia_vip_test"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# API da Barbearia VIP. BARBEARIA_VIP_CLIENT=mock usa o cliente simulado (ver src/lib/barbearia-vip/mock-client.ts)
BARBEARIA_VIP_CLIENT="mock"
BARBEARIA_VIP_API_URL="https://franquiabv.com.br"
# none | bearer | api-key  (a API é aberta hoje; trocar quando a autenticação for lançada)
BARBEARIA_VIP_AUTH_SCHEME="none"
BARBEARIA_VIP_API_KEY=""

# Cloudflare Turnstile (vazio em dev = verificação desligada)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Segredos locais. Gerar com: openssl rand -hex 32
IP_HASH_SALT="dev-ip-salt"
PIN_SALT="dev-pin-salt"
ADMIN_TOKEN="dev-admin-token"
CRON_SECRET="dev-cron-secret"

# PIN das unidades de exemplo criadas pelo seed (só dev)
SEED_UNIT_PIN="123456"
